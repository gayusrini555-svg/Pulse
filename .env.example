# Buffer app client (publish.buffer.com/settings/api)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional on Vercel production (defaults to https://<your-domain>/callback)
REDIRECT_URI=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# AI: set ONE of these keys (or several, and pick with AI_PROVIDER=gemini|claude|openai)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=
OPENAI_MODEL=

# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
