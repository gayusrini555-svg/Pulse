# Buffer app client (publish.buffer.com/settings/api)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional on Vercel production (defaults to https://<your-domain>/callback)
REDIRECT_URI=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# AI: set ONE of these keys (or several, and pick with AI_PROVIDER=gemini|claude|openai)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=
OPENAI_MODEL=

# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional free backup on open-source models (used automatically when the main AI is busy).
# Groq by default: create a key at console.groq.com. Any OpenAI-compatible host works.
OPEN_MODEL_API_KEY=
# OPEN_MODEL_BASE_URL=https://api.groq.com/openai/v1
# OPEN_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile

# Optional backup web search for Ask Pulse when Gemini's search quota runs out (free: 1,000/month at tavily.com).
TAVILY_API_KEY=
